{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@ai/constants": ["./packages/constants/src/index.ts"],
      "@ai/constants/*": ["./packages/constants/src/*"],
      "@ai/types": ["./packages/types/index.d.ts"],
      "@ai/utils": ["./packages/utils/src/index.ts"],
      "@ai/utils/*": ["./packages/utils/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
