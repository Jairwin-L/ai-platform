# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
/apps/platform/.postgres-upgrades/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files：任何 .env / .env.* 都不入库（公开仓库），只允许无敏感值的 .env.example
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.prisma/
/apps/*/generated/

# db-service 打包产物（vp pack）与 OpenAPI 预览产物
/apps/db-service/dist/
/apps/db-service/dist-openapi/

# admin 构建产物
/apps/admin/dist/
/apps/admin/dist-dev/

# vite+ hooks dispatcher (generated by `vp config`)
.vite-hooks/_

# Playwright / 测试产物
test-results/
playwright-report/
blob-report/

# teamai 单仓模式（mode: self）：.teamai/ 下的 knowledge（skills/rules/docs/learnings 等）
# 要随业务代码一起入库，机器本地状态（config.yaml 含本机绝对路径与用户名、token 等）
# 由 .teamai/.gitignore 自己声明，此处不做整目录忽略。
.teamai/team-repo/

# 本地 Agent 配置（个人权限设置，不共享；.claude/settings.json 里的团队 hooks 要入库）
.claude/settings.local.json
.claude/worktrees/

# teamai pull 的产物：skills 的唯一来源是 .teamai/skills/，各 AI 工具目录下的副本
# 由 `teamai pull` 在会话启动时自动生成，入库只会变成同一份内容的多处拷贝。
# .agents/、.windsurf/、skills-lock.json 是 `npx skills add` 生成的，同样不入库。
**/.claude/skills/
**/.codex/skills/
**/.agents/
**/.windsurf/
**/skills-lock.json
