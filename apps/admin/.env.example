# 管理后台环境变量示例。复制为 apps/admin/.env.local 后按需修改（.env* 均不入库）。
# VITE_* 会被编译进前端产物，只能放公开信息，禁止写入任何密钥。

# 浏览器标题与侧边栏文案
VITE_APP_TITLE=管理后台

# 接口基址：本地开发保持 /api，由 vite 代理转发到 db-service；
# 线上填 db-service 的公网地址（如 https://api.example.com），并把管理后台域名加进 db-service 的 CORS_ALLOWED_ORIGINS
VITE_BASE_API_URL=/api

# 仅开发态：vite 代理转发的 db-service 地址
VITE_DEV_API_TARGET=http://localhost:8070

# 管理后台顶栏「前台站点」入口，留空则不显示
VITE_PLATFORM_URL=
