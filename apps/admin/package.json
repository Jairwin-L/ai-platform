{
  "name": "@ai/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build --mode production",
    "build:dev": "vp build --mode development --outDir dist-dev",
    "preview": "vpr build && vp preview",
    "check": "vp check",
    "lint": "vp check && vp exec stylelint --allow-empty-input --max-warnings 0 \"**/*.{css,less,scss}\"",
    "lint:fix": "vp check --fix && vp exec stylelint --allow-empty-input --fix \"**/*.{css,less,scss}\"",
    "test": "vp test"
  },
  "dependencies": {
    "@ai/constants": "workspace:*",
    "@ant-design/icons": "^6.1.0",
    "alova": "^3.3.4",
    "antd": "^6.4.4",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.9.4",
    "zod": "^4.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ai/types": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "sass": "^1.101.0",
    "stylelint": "^16.24.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
