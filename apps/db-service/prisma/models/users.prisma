/// 平台注册用户：只走前台邮箱注册 / 登录，没有角色体系；管理端账号见 SystemUser。
model Users {
  id                String         @id
  full_name         String?
  nick_name         String?
  user_name         String?        @unique
  picture           String?
  email             String?        @unique
  email_verified    Boolean?       @default(false)
  password_hash     String?
  bio               String?
  status            UserStatusType @default(active)
  /// 后台限制 / 停用 / 封禁时填写的原因，会展示给用户本人
  status_reason     String?        @db.VarChar(255)
  /// 受限 / 封禁的截止时间；为空表示需要后台手动恢复，到期后自动恢复为 active
  status_expires_at DateTime?      @db.Timestamptz(6)
  is_deleted        Boolean        @default(false)
  deleted_at        DateTime?      @db.Timestamptz(6)
  last_login_at     DateTime?      @db.Timestamptz(6)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)

  sessions            UserSessions[]
  ai_provider_configs AiProviderConfig[]
  chat_conversations  ChatConversation[]
  ai_usage            AiUsage[]

  @@index([status])
  @@map("users")
}

model UserSessions {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_sessions")
}

/// 后台系统用户：只按 account 登录管理端，与平台用户分表，两边账号空间互不占用。
model SystemUser {
  id          String         @id
  account     String         @unique @db.VarChar(100)
  password    String
  username    String?        @db.VarChar(100)
  nickname    String?
  avatar      String?
  remark      String?        @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt DateTime?      @map("last_login_at") @db.Timestamptz(6)
  status      UserStatusType @default(active)
  userRoles   UserRole[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("system_users")
}

model UserRole {
  id        String     @id
  userId    String     @map("user_id")
  roleId    String     @map("role_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}
