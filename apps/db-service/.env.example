# db-service 本地开发环境变量示例。复制为 apps/db-service/.env 后填入真实值：
#   cp apps/db-service/.env.example apps/db-service/.env
# .env 已被 .gitignore 忽略；本文件只允许出现占位值，禁止写入任何真实密钥、连接串、域名或个人信息。

# 服务端口（本地开发默认 8070）
PORT=8070

# 数据库（仅连本地或 dev 库，不要把生产库连接串放进本地 env 文件）
DATABASE_URL="postgresql://user:password@localhost:5432/ai_platform_dev?schema=public"

# Redis（会话、限流、验证码、BYOK 密文都存在这里）
REDIS_URL="redis://localhost:6379/0"

# 额外允许跨域的来源（逗号分隔，支持 https://*.example.com 形式的单段通配）。
# 本地 platform(8060) / admin(8050) 已内置；线上把管理后台的域名加进来
CORS_ALLOWED_ORIGINS=

# 生产环境默认隐藏 /doc，需要开放时设为 true
ENABLE_API_DOCS=false

# 登录验证码 HMAC 密钥，生产环境必须使用随机值：openssl rand -base64 32
AUTH_CODE_SECRET=

# Resend 邮件（验证码）
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=

# 首个超级管理员系统账号（管理端登录用，与 platform 注册账号分表）。
# seed 后执行 prisma:bootstrap-admin：账号不存在时创建并授予 SUPER_ADMIN，已存在时只补 SUPER_ADMIN、不改密码；
# 两者都为空时跳过。密码至少 12 位，只写在本地 .env / 部署平台 Secrets，禁止提交真实值
BOOTSTRAP_ADMIN_ACCOUNT=
BOOTSTRAP_ADMIN_PASSWORD=
# 设为 true 时把已存在账号的密码重置为 BOOTSTRAP_ADMIN_PASSWORD（一次性找回用，用完改回 false）
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# BYOK：32 字节 Base64 主密钥（openssl rand -base64 32）与独立的 Redis ID secret，两者不能共用
AI_KEY_ENCRYPTION_KEY_V1=
AI_KEY_REDIS_ID_SECRET=
# 可选：AI Provider 配置里 API Key 的加密主密钥，缺省时回退到 AI_KEY_ENCRYPTION_KEY_V1
AI_SECRET_MASTER_KEY=
# db-service 在 platform 反向代理之后，生产环境需要设为 true 才能按 X-Forwarded-Proto 识别 HTTPS
BYOK_TRUST_PROXY_HEADERS=false

# Cloudflare R2 直传
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
