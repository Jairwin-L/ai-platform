{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ai/constants": ["../../packages/constants/src/index.ts"],
      "@ai/constants/*": ["../../packages/constants/src/*"],
      "@ai/types": ["../../packages/types/index.d.ts"],
      "@ai/utils": ["../../packages/utils/src/index.ts"],
      "@ai/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/types/src/**/*.d.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
