# platform（Next.js 前台）环境变量示例：只写占位值，真实值放 .env / 部署平台，不要提交。
# 接口、数据库、Redis、密钥等都已迁到 apps/db-service，见 apps/db-service/.env.example。

# db-service 内网地址：SSR 直连 + next.config.ts rewrites 的转发目标（构建期写入，改动需重新构建）
API_INTERNAL_ORIGIN=http://localhost:8070

# 管理后台地址（apps/admin）；留空则前台账户菜单不展示后台入口（构建期内联）
NEXT_PUBLIC_ADMIN_URL=
