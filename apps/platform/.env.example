# 本地开发环境变量示例。复制为 apps/platform/.env 后填入真实值：
#   cp apps/platform/.env.example apps/platform/.env
# .env 已被 .gitignore 忽略；本文件只允许出现占位值，禁止写入任何真实密钥、连接串或个人信息。

# 数据库（仅连本地或 dev 库，不要把生产库连接串放进本地 env 文件）
DATABASE_URL="postgresql://user:password@localhost:5432/ai_platform_dev?schema=public"

# Redis（必填；Docker Compose 部署内由 compose 注入 redis://redis:6379/0）
REDIS_URL="redis://localhost:6379/0"

# 登录验证码 HMAC 密钥，生产环境必须使用随机值：openssl rand -base64 32
AUTH_CODE_SECRET=

# Resend 邮件
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=

# 首个管理员邮箱（为空或用户不存在时跳过授权）
BOOTSTRAP_ADMIN_EMAIL=

# BYOK：32 字节 Base64 主密钥（openssl rand -base64 32）与独立的 Redis ID secret，两者不能共用
AI_KEY_ENCRYPTION_KEY_V1=
AI_KEY_REDIS_ID_SECRET=
# 可选：AI 凭据加密主密钥，缺省时回退到 AI_KEY_ENCRYPTION_KEY_V1
AI_SECRET_MASTER_KEY=
BYOK_TRUST_PROXY_HEADERS=false
BYOK_ALLOWED_ORIGINS=

# Cloudflare R2 直传
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=

# 生产环境默认隐藏 /api/doc，需要开放时设为 true
ENABLE_API_DOCS=false
